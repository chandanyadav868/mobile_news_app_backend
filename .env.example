# ==============================================================================
# NewsFlow Production Environment Configuration
# Copy this to .env or paste into Coolify Environment Variables
# ==============================================================================

# Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN=*

# PostgreSQL Database (Host is 'postgres' when running inside Docker Compose)
POSTGRES_USER=newsflow_user
POSTGRES_PASSWORD=your_strong_secret_password_here
POSTGRES_DB=newsflow_db
DATABASE_URL=postgresql://newsflow_user:your_strong_secret_password_here@postgres:5432/newsflow_db?schema=public

# Redis Cache (Host is 'redis' when running inside Docker Compose)
REDIS_URL=redis://redis:6379

# RSS Ingestion Schedule & Concurrency
RSS_INGEST_INTERVAL_MINUTES=5
READABILITY_MAX_CONCURRENCY=3
